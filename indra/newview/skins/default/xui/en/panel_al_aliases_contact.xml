<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
        follows="top|left|right"
        height="22"
        layout="topleft"
        left="0"
        name="al_aliases_contact_item"
        top="0"
        width="496">

    <text
        follows="left|top|right"
        font="SansSerifSmall"
        height="18"
        layout="topleft"
        left="4"
        name="contact_name"
        top="2"
        use_ellipses="true"
        width="258" />

    <al_alias_line_editor
        follows="left|top|right"
        height="18"
        layout="topleft"
        left_pad="8"
        max_length_chars="63"
        name="contact_alias"
        tool_tip="Shared alias used by the club invitation and friends here floaters. Leave empty to use the display name."
        top="2"
        right="-4" />
</panel>