<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel
 name="panel_greeter"
 width="327"
 height="333">
    <string name="no_newcomers" value="No newcomers — all strangers greeted!" />
    <string name="no_filtered_newcomers" value="No matching newcomers." />
    <string name="greeter_count" value="[COUNT] newcomer(s) not yet greeted" />
    <panel
     background_opaque="false"
     background_visible="false"
     follows="all"
     height="333"
     layout="topleft"
     left="0"
     name="greeter_panel"
     top="0"
     width="327">
        <panel
         follows="left|top|right"
         height="27"
         layout="topleft"
         left="0"
         name="greeter_buttons_panel"
         right="-1"
         top="0">
            <filter_editor
             follows="left|top|right"
             height="23"
             layout="topleft"
             left="3"
             label="Filter"
             max_length_chars="300"
             name="greeter_filter_input"
             top="1"
             width="150" />
            <button
             follows="right"
             height="23"
             layout="topleft"
             left_pad="5"
             name="greet_btn"
             label="Greet"
             tool_tip="Send welcome message to all ungreeted strangers"
             top="1"
             width="60">
                <commit_callback function="Greeter.Greet" />
            </button>
            <button
             follows="right"
             height="23"
             layout="topleft"
             left_pad="5"
             name="reset_btn"
             label="Reset"
             tool_tip="Clear greeted list so everyone appears again"
             top="1"
             width="60">
                <commit_callback function="Greeter.Reset" />
            </button>
        </panel>
        <line_editor
         follows="left|top|right"
         height="23"
         layout="topleft"
         left="3"
         max_length_chars="500"
         name="greeter_message_input"
         label="Welcome message — use {NAMES} for the list"
         top_pad="5"
         right="-3" />
        <text
         follows="left|top|right"
         height="16"
         layout="topleft"
         left="3"
         name="greeter_count"
         top_pad="5"
         right="-3"
         use_ellipses="true">
         0 newcomer(s) not yet greeted
        </text>
        <avatar_list
         allow_select="true"
         follows="all"
         height="220"
         layout="topleft"
         left="3"
         multi_select="true"
         name="greeter_list"
         right="-3"
         top_pad="5" />
    </panel>
</panel>
